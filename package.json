{
  "name": "streamprobe-mcp",
  "version": "0.1.0",
  "description": "MCP server that diagnoses HLS and DASH streams. Reads manifests over HTTP and reports what is wrong, with no ffmpeg required.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@8.15.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "streamprobe-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm pack:check",
    "pack:check": "npm pack --dry-run",
    "example": "tsx examples/diagnose.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hls",
    "dash",
    "m3u8",
    "mpd",
    "video-streaming",
    "ott",
    "drm",
    "diagnostics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeDTX/streamprobe-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/CodeDTX/streamprobe-mcp/issues"
  },
  "homepage": "https://github.com/CodeDTX/streamprobe-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-xml-parser": "^5.11.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
